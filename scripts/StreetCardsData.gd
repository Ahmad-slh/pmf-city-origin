var available_good_cards := []
var available_bad_cards := []

# تحتوي جميع البطاقات الجيدة والسيئة معًا
var all_cards: Array = []

func _ready() -> void:
	reset_cards()

func reset_cards() -> void:

	# تجهيز نسخ البطاقات المستخدمة في السحب العشوائي الطبيعي
	available_good_cards = good_cards.duplicate(true)
	available_bad_cards = bad_cards.duplicate(true)

	# تفريغ القائمة الموحدة قبل تعبئتها
	all_cards.clear()

	# إضافة جميع البطاقات الجيدة أولًا
	for card in good_cards:
		all_cards.append(card)

	# إضافة جميع البطاقات السيئة بعدها
	for card in bad_cards:
		all_cards.append(card)

	print("عدد البطاقات الجيدة: ", good_cards.size())
	print("عدد البطاقات السيئة: ", bad_cards.size())
	print("إجمالي all_cards: ", all_cards.size())

func get_random_good_card() -> Dictionary:
	if available_good_cards.is_empty():
		available_good_cards = good_cards.duplicate(true)

	return available_good_cards.pop_at(randi() % available_good_cards.size())


func get_random_bad_card() -> Dictionary:
	if available_bad_cards.is_empty():
		available_bad_cards = bad_cards.duplicate(true)

	return available_bad_cards.pop_at(randi() % available_bad_cards.size())


var debug_use_selected_card := false

# تحتوي أرقام العناصر المختارة من all_cards
var debug_selected_cards: Array[int] = []

func get_random_event_card() -> Dictionary:

	# ==================================================
	# وضع الفحص اليدوي
	# ==================================================
	if debug_use_selected_card:

		# إذا لم يتم اختيار أي بطاقة، نكمل بالسحب الطبيعي.
		# إرجاع قاموس فارغ هنا كان يمنع ظهور البطاقة، فلا ينتهي الدور
		# وتتجمد اللوحة بمجرد فتح لوحة الفحص دون اختيار شيء.
		if debug_selected_cards.is_empty():
			print("لم يتم اختيار أي بطاقة من لوحة Debug، سيتم السحب الطبيعي")

		else:
			# اختيار رقم عشوائي من العناصر التي اختارها المستخدم
			var random_index: int = debug_selected_cards.pick_random()

			# حماية من رقم خارج حدود all_cards
			if random_index < 0 or random_index >= all_cards.size():
				print("رقم البطاقة المختارة غير صحيح: ", random_index)

			else:
				var selected_card: Dictionary = all_cards[random_index]

				print("تم اختيار بطاقة Debug:")
				print("رقمها داخل all_cards: ", random_index)
				print("النوع: ", selected_card.get("type", "UNKNOWN"))
				print("التأثير: ", selected_card.get("effect", "NONE"))

				return selected_card

	# ==================================================
	# الوضع الطبيعي
	# ==================================================
	var choose_good := randi() % 2 == 0

	if choose_good:
		return get_random_good_card()
	else:
		return get_random_bad_card()


func get_card_by_effect(effect_id: int) -> Dictionary:
	for card in all_cards:
		if card.get("id", "") == effect_id:
			return card

	for card in bad_cards:
		if card.get("id", "") == effect_id:
			return card

	return {}
