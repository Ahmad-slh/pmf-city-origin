[node name="RulesText" type="RichTextLabel" parent="RulesPopup"]
layout_mode = 0
offset_left = 60.0
offset_top = 88.0
offset_right = 1060.0
offset_bottom = 670.0
theme_override_colors/default_color = Color(0.13, 0.16, 0.22, 1)
theme_override_constants/line_separation = 8
theme_override_font_sizes/normal_font_size = 20
bbcode_enabled = true
text = "[right][font_size=22]أهلاً بكم في مدينة المالية العامة! هدفكم هو استكشاف المدينة، واختبار معرفتكم بالمالية العامة، وقيادة فريقكم للفوز.[/font_size]

[font_size=25][b]هدف اللعبة[/b][/font_size]
التنقل داخل المدينة، والإجابة عن الأسئلة بشكل صحيح، والسيطرة على القطاعات لتحقيق أعلى نتيجة.

[font_size=25][b]الفرق والشخصية الرئيسية[/b][/font_size]
• [b]فريقان متنافسان:[/b] تُلعب اللعبة بين فريقين.
• [b]هوية الفريق:[/b] يختار كل فريق لوناً لشخصية حنظلة قبل بدء اللعبة، ليكون هوية الفريق الخاصة.
• [b]نهاية اللعبة:[/b] تنتهي عند انتهاء ساعتين (120 دقيقة)، أو عند إغلاق جميع القطاعات، أيهما يحدث أولًا.
• [b]حجر النرد:[/b]
  • يُرمى حجر النرد مرتين في بداية اللعبة لمعرفة الفريق الذي سيبدأ؛ وهو الفريق الحاصل على الرقم الأكبر.
  • في كل دور، يرمي الفريق حجر النرد لتحديد مساره على خريطة اللعبة.
  • لا تُحتسب الشوارع أو القطاعات المغلقة ضمن الرقم الظاهر على حجر النرد.

[font_size=25][b]طريقة اللعب: خطوة بخطوة[/b][/font_size]

[font_size=22][b]1- البداية من المركز المشترك[/b][/font_size]
يبدأ الفريقان من نقطة الانطلاق المركزية، المرفقة والموضحة بسهم في خريطة المدينة.

[font_size=22][b]2- التنقل في اللعبة[/b][/font_size]
• في دور فريقك، يمكنك التحرك بحرية في اتجاهات متعددة عبر المدينة، سواء عبر شارع أو قطاع، بحسب عدد نقاط حجر النرد.
• [b]انتبه إلى حالة الشارع أثناء المرور:[/b]
  • [b]المرور الأول:[/b] يصبح الشارع متضرراً/مكسوراً.
  • [b]المرور الثاني:[/b] يصبح الشارع مغلقاً، ولا يمكن المرور منه مجدداً.
• [b]بطاقات أحداث الشوارع:[/b] المرور بشارع معيّن يفعّل بطاقة مزدوجة:
  • جانب يحتوي على معلومة مالية توعوية من السياق الفلسطيني.
  • الجانب الآخر يحتوي على مكافأة إيجابية أو عقوبة/تحدٍّ.

[font_size=22][b]استكشاف القطاعات المالية (14 قطاعاً)[/b][/font_size]
• تضم المدينة 14 قطاعاً مالياً حكومياً.
• يحتوي كل قطاع على سؤالين تعليميين، وبعد الإجابة عن السؤالين، سواء كانت الإجابات صحيحة أو خاطئة، يُغلق القطاع نهائياً.
• عند حصولكم على إجابة صحيحة، يتلوّن القطاع بلون فريقكم.

[font_size=25][b]وضع التحدي (Battle Mode)![/b][/font_size]
عندما يتواجد الفريقان في القطاع نفسه في الوقت نفسه، يتفعّل وضع التحدي.
• يظهر السؤال ويقرأه اللاعبون.
• يجيب عن السؤال الفريق الأسرع في اختيار الإجابة.
• إذا أجاب الفريق المدافع إجابة صحيحة، يبقى القطاع بلون فريقه ويُغلق نهائياً.
• إذا أجاب الفريق المهاجم إجابة صحيحة، يتلوّن القطاع بلونه ويُغلق نهائياً.
• إذا انتهى الوقت ولم يُجب أحد، يتحول القطاع إلى اللون الرمادي ويُغلق نهائياً.

[font_size=25][b]الفوز باللعبة[/b][/font_size]
الفريق الذي يسيطر على أكبر عدد من القطاعات، ويتلوّن الجزء الأكبر من خريطة المدينة بلونه، يكون هو الفريق الفائز ويُتوّج ملك اللعبة.

[font_size=25][b]نصيحة سريعة للاعبين[/b][/font_size]
تعلّم وأنت تلعب! اقرأ المعلومات المالية في بطاقات الشوارع وعلى ظهر أسئلة القطاعات؛ فهذا هو الهدف الأساسي من اللعبة.[/right]"
text_direction = 3

