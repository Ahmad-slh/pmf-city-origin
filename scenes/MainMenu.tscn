[node name="RulesText" type="RichTextLabel" parent="RulesPopup"]
layout_mode = 0
offset_left = 60.0
offset_top = 100.0
offset_right = 840.0
offset_bottom = 500.0
theme_override_colors/default_color = Color(0.13, 0.16, 0.22, 1)
theme_override_font_sizes/normal_font_size = 21
bbcode_enabled = true
text = "١. تتنافس فرقتان: الفريق الأزرق والفريق الأخضر.
٢. في كل دور يرمي الفريق النرد ويحرك قطعته إلى أحد القطاعات.
٣. يمكن للفريق الاستثمار في القطاع الذي وصل إليه.
٤. عند وصول فريق إلى قطاع مملوك للفريق الآخر تبدأ معركة تُحسم بأسئلة معرفية.
٥. بطاقات الشارع وبطاقات القطاع تمنح تأثيرات إيجابية أو سلبية مؤقتة.
٦. الفريق الذي يجمع أكبر قدر من الاستثمارات والقطاعات يفوز باللعبة."

