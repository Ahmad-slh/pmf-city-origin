theme_override_colors/default_color = Color(0.13, 0.16, 0.22, 1)
theme_override_font_sizes/normal_font_size = 21
bbcode_enabled = true
text = "مدينة PMF هي لعبة لوحية رقمية تعليمية لفريقين، تحاكي إدارة مدينة والاستثمار في قطاعاتها المختلفة. تعلّم مفاهيم الموازنة العامة والإدارة المالية بأسلوب ممتع وتنافسي من خلال النرد والبطاقات والمعارك المعرفية."
